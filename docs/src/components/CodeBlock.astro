---
import { renderCodeToHTML, runTwoSlash, createShikiHighlighter } from "shiki-twoslash"
import { Markdown, Markup } from "astro-remote";
import CodeSpan from "../components/CodeSpan.astro";

import Heading from "../components/Heading.astro";
import Note from "../components/Note.astro";
import '../styles/shiki-twoslash.css'

export let html = ``
const highlighter = await createShikiHighlighter({ theme: "material-ocean" })
const { lang, code, ...props } = Astro.props;

if (['ts', 'tsx'].includes(lang)) {
  const twoslash = runTwoSlash(
    code, 
    lang, 
    {}
  )
  html = renderCodeToHTML(
    twoslash.code, 
    lang, 
    { twoslash: true }, 
    { themeName: "material-ocean" }, 
    highlighter, 
    twoslash
  )
} else {
  html = renderCodeToHTML(applyCut(code), lang, {}, { themeName: "material-ocean" }, highlighter);
}

function applyCut (s: string) {
  return s.split(/\/\/ \-\-\-cut\-\-\-\s*/).pop() ?? ''
}

---
{
  lang === 'md' 
  ? <Markdown
      content={code}
      components={{ Heading, CodeBlock, CodeSpan, Note }}
    /> 
  : <div set:html={html} />
}
